# TradingView Webhook Bot - Environment Variables Example
# Bu dosyayı '.env' olarak kaydedin ve kendi bilgilerinizi girin.

# 1. GÜVENLİK
PASSPHRASE=guclu_bir_sifre_belirleyin
ALLOWED_IPS=127.0.0.1,localhost,52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7

# 2. İŞLEM MODU VE RİSK (PAPER = Simülasyon, LIVE = Gerçek)
TRADING_MODE=PAPER
CURRENT_RISK_MODE=NORMAL

# 3. ALPACA API KİMLİK BİLGİLERİ (Gerekiyorsa)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# 4. LLM API KİMLİK BİLGİLERİ (Eğer LLM aktifse)
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
LLM_PROVIDER=gemini # 'gemini' veya 'openai' kullanabilirsiniz
