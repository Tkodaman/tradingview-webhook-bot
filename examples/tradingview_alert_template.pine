//@version=5
strategy("TV AI Gateway & Multi-Layer Risk Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=5)

// --- Girdiler ---
rsi_len = input.int(14, "RSI Periyodu")
atr_len = input.int(14, "ATR Periyodu")
vol_len = input.int(20, "Hacim Ortalaması Periyodu")
passphrase = input.string("secret_key", "Webhook Güvenlik Anahtarı")

// --- İndikatör Hesaplamaları ---
rsi_val = ta.rsi(close, rsi_len)
atr_val = ta.atr(atr_len)
vol_avg = ta.sma(volume, vol_len)
vol_ratio = vol_avg > 0 ? (volume / vol_avg) : 1.0
volatility_pct = (atr_val / close) * 100.0

// --- Basit Örnek Strateji Koşulları ---
buy_condition = ta.crossover(ta.sma(close, 9), ta.sma(close, 21)) and rsi_val > 50
sell_condition = ta.crossunder(ta.sma(close, 9), ta.sma(close, 21)) and rsi_val < 50

// --- Webhook JSON Mesaj Formatı ---
// TradingView Alarm Mesajı Kutusu içine aşağıdaki şablonu yapıştırın:
/*
{
  "passphrase": "secret_key",
  "action": "BUY",
  "symbol": "{{ticker}}",
  "price": {{close}},
  "quantity": 1.0,
  "timeframe": "{{interval}}",
  "indicators": {
    "rsi": {{plot_0}},
    "volatility": {{plot_1}},
    "volume_ratio": {{plot_2}}
  },
  "macro_tags": ["TRADE_FLOW", "AUTO_SIGNAL"]
}
*/

if (buy_condition)
    strategy.entry("Long", strategy.long, alert_message='{"passphrase":"' + passphrase + '","action":"BUY","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"quantity":1.0,"indicators":{"rsi":' + str.tostring(rsi_val) + ',"volatility":' + str.tostring(volatility_pct) + ',"volume_ratio":' + str.tostring(vol_ratio) + '},"macro_tags":["AUTO_LONG"]}')

if (sell_condition)
    strategy.entry("Short", strategy.short, alert_message='{"passphrase":"' + passphrase + '","action":"SELL","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"quantity":1.0,"indicators":{"rsi":' + str.tostring(rsi_val) + ',"volatility":' + str.tostring(volatility_pct) + ',"volume_ratio":' + str.tostring(vol_ratio) + '},"macro_tags":["AUTO_SHORT"]}')

plot(ta.sma(close, 9), "SMA 9", color=color.green)
plot(ta.sma(close, 21), "SMA 21", color=color.red)
